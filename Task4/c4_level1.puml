@startuml Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Определение стилей для упрощения
HIDE_STEREOTYPE()

title Диаграмма Контекста (Level 1) \n Разгрузка КЦ и Ставки

' Определяем Действующих Лиц (Users/Actors)
Person(client, "Клиент", "Пользователь, открывающий депозит или звонящий для консультации")
Person(bck_manager, "Менеджер Бэк-офиса", "Подтверждает условия и открывает депозит в АБС")

' Определяем Систему (Software System)
System(bank_system, "Банковская Система (Наше Решение)", "IT-системы для открытия депозитов и дистрибуции ставок")

' Определяем Внешние Системы
System_Ext(sms_gateway, "СМС-Шлюз", "Внешний сервис телеком-оператора")
System_Ext(partner_cc_system, "Система Партнёрского КЦ", "**Подключение для разгрузки**, получает ставки по файлу (SFTP)")
System_Ext(abs, "АБС (Core Banking)", "Ядро банковских операций")
System_Ext(cc_system, "Система Кол-центра (Внутр.)", "Обработка заявок и консультации (API)")

' Отношения между Действующими Лицами и Системой
Rel(client, bank_system, "Использует для открытия депозита и получения актуальных ставок")

' Отношения Системы с Внешними Системах
Rel(bank_system, sms_gateway, "Отправляет СМС-уведомления")
Rel(bank_system, abs, "Читает данные, создает депозит")
Rel_L(bank_system, cc_system, "Передает ставки (API) и получает заявки")
Rel_R(bank_system, partner_cc_system, "**Дистрибуция ставок для консультации**", "Файловый обмен (SFTP)")

' Дополнительные связи
Rel_L(client, cc_system, "Звонит за консультацией (основной канал)")
Rel_R(client, partner_cc_system, "Звонит за консультацией (доп. канал)")

@enduml