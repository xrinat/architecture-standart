@startuml Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

' Определение стилей
HIDE_STEREOTYPE()

title Диаграмма Контейнеров (Level 2) \n MVP Открытие Депозитов

' Определяем Действующих Лиц
Person(client, "Клиент", "Пользователь, открывающий депозит")
Person(bck_manager, "Менеджер Бэк-офиса", "Подтверждает условия и открывает депозит")

' Определяем Внешние Системы
System(sms_gateway, "СМС-Шлюз", "Внешний сервис телеком-оператора")
System(cc_system, "Система Кол-центра", "Обрабатывает заявки с Сайта (React, Java)")

' Определяем Контейнеры (Software Systems) внутри Банка
System_Boundary(bank_system, "Банковская Система") {

    ' Каналы (Монолиты)
    Container(ib, "Интернет-Банк", "ASP.NET MVC 4.5, .NET Framework 4.5, MS SQL", "Веб-интерфейс для существующих клиентов")
    Container(site, "Сайт Банка", "PHP, React.js", "Веб-интерфейс для новых клиентов")

    ' Новый Интеграционный Слой (Микросервисы)
    Container(api_gw, "API Gateway / Service Bus", "Java Spring Boot", "Единая точка входа, защита (NF.4) и оркестрация (A.2)")
    Container(src, "Сервис Расчета Ставок (СРС)", "Java Spring Boot, PostgreSQL/MS SQL", "Централизованная логика расчета ставок (F.8)")
    ContainerQueue(kafka, "Kafka", "Очередь сообщений", "Асинхронная передача заявок (A.4) и разгрузка АБС (NF.7)")
    Container(soz, "Сервис Оркестрации Заявок (СОЗ)", "Java Spring Boot", "Управление жизненным циклом заявки и взаимодействие с АБС")

    ' Устаревший Монолит (Ядро)
    ContainerDb(abs_db, "БД АБС", "Oracle", "Хранение данных счетов, депозитов и риска")
    Container(abs, "АБС", "Delphi, PL/SQL", "Ядро банковских операций. Финальное открытие депозита (F.6)")
}

' Отношения между Контейнерами и Внешними Объектами

' 1. Каналы
Rel(client, ib, "Использует для просмотра ставок и подачи заявки", "HTTPS (A.1)")
Rel(client, site, "Подает заявку (новый клиент)", "HTTPS (A.1)")

' 2. Обработка Заявок и Ставок
Rel(ib, api_gw, "Запрос ставок, отправка заявки", "HTTPS (A.1)")
Rel_L(api_gw, src, "Запрос актуальных/персонализированных ставок (F.3)")
Rel(api_gw, kafka, "Отправляет заявку на открытие депозита", "Асинхронно")

Rel_U(site, cc_system, "Передает заявку нового клиента (F.1)")
Rel(cc_system, bck_manager, "Используется для обработки заявок")

' 3. Оркестрация и Ядро
Rel(kafka, soz, "Получает заявку на обработку", "Асинхронно")
Rel_R(soz, abs, "Подает команду на открытие депозита", "Синхронно/API")
Rel(src, abs, "Получает данные о кредитном риске клиента", "Синхронно/API")
Rel(abs, abs_db, "Читает и записывает данные", "JDBC/SQL")

' 4. Оповещения
Rel(abs, sms_gateway, "Отправляет команду на СМС-оповещение (F.7)")
Rel_R(bck_manager, abs, "Подтверждает условия в АБС (F.6)")

@enduml